# Generate before first start: mkdir -p secrets && openssl rand -hex 32 > secrets/jwt_secret
# The file is mounted as a Compose secret instead of exposed in container metadata.
DROGON_JWT_SECRET_PATH=./secrets/jwt_secret

# Host port is bound to 127.0.0.1 by compose.yml.
DROGON_PORT=8080
DROGON_REGISTRATION_MODE=first-user

# Application-level login budget (per process and per normalized email).
DROGON_LOGIN_RATE_LIMIT_GLOBAL=120
DROGON_LOGIN_RATE_LIMIT_PER_IDENTIFIER=10
DROGON_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Comma-separated exact origins. Leave empty for same-origin deployments.
DROGON_CORS_ALLOWED_ORIGINS=
DROGON_CORS_ALLOW_CREDENTIALS=false

# Enable only when every public request is served through HTTPS.
DROGON_ENABLE_HSTS=false

# Must remain lower than compose.yml stop_grace_period (15s).
DROGON_SHUTDOWN_GRACE_SECONDS=10

# SQLite online backup sidecar (docker compose --profile ops run --rm backup).
DROGON_BACKUP_DIR=./backups
DROGON_BACKUP_RETAIN=14
# On Linux, optionally set these to the operator's `id -u` / `id -g`.
# DROGON_BACKUP_UID=1000
# DROGON_BACKUP_GID=1000
